#!/bin/bash

# backward compat since cached function went away
# https://pagure.io/rpkg-util/c/bb62554c62fd52224709e861c2353a5c15b50220?branch=main
function cached {
  declare v=${OUTPUT[$1]}
  [[ -n $v ]] && echo -n "$v"
}

function abort {
  echo "ABORT: $*" >&2
  exit 1
}

# --- version source of truth, fetched once ---
function _ghostty_raw {
  cached _ghostty_raw && return
  declare v
  v=$(curl -sL https://github.com/ghostty-org/ghostty/releases/download/tip/ghostty-source.tar.gz |
    tar xzf - -O --wildcards '*/VERSION' 2>/dev/null | tr -d '[:space:]')
  [[ -n $v ]] || abort "failed to determine ghostty version from tarball"
  # 1.3.2-main-+88f57ee
  [[ $v =~ ^([0-9.]+)-([^-]+)-\+?([0-9a-f]+)$ ]] || abort "unexpected VERSION format: $v"
  output "${BASH_REMATCH[1]} ${BASH_REMATCH[2]} ${BASH_REMATCH[3]}"
}

# RPM Version: tag -- must sort monotonically, date-prefixed
function ghostty_version {
  cached ghostty_version && return
  declare version _branch hash datestamp
  read -r version _branch hash < <(_ghostty_raw)
  datestamp=$(date -u +%Y%m%d%H%M)
  output "${version}^${datestamp}.g${hash}"
}

# embedded/user-facing build id -- clean, no date, just upstream+hash
function ghostty_buildid {
  cached ghostty_buildid && return
  declare version _branch hash
  read -r version _branch hash < <(_ghostty_raw)
  output "${version}+${hash}"
}

